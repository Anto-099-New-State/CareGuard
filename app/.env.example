# Copy to .env.local. Never commit real values; on the host, set these in its secret settings.

# Which network: local (anvil) | testnet | mainnet. Picks config/<network>.json.
NEXT_PUBLIC_NETWORK=testnet

# Supabase. URL and publishable key are public; the secret key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# Circle developer-controlled wallets (testnet/mainnet). Not needed on local.
# API key: https://console.circle.com/ → API & Client Keys. Then `npm run circle:setup` fills in the rest below.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=
# The agent's Circle wallet: holds only gas.
AGENT_WALLET_ID=
AGENT_ADDRESS=
# Shown in the sidebar (public).
NEXT_PUBLIC_AGENT_ADDRESS=
# EURC → USDC swaps use CIRCLE_API_KEY. Only set KIT_KEY if you still have a legacy kit key.
# KIT_KEY=

# Groq reviews charges that pass every deterministic check. Without a key, those charges escalate to the approver.
# Key: https://console.groq.com/keys
GROQ_API_KEY=
# Optional: a Groq model with strict JSON-schema output.
# GROQ_MODEL=openai/gpt-oss-120b
# Local end-to-end only: accept charges that pass the checks without calling the LLM. Refused on testnet/mainnet.
# AGENT_JUDGE=stub

# Defaults from docs/README.md "Open decisions". Uncomment to change.
# DEFAULT_CONTINGENCY_BPS=2000     # 20%
# DEFAULT_CAP_BPS=2500             # 25% of the guarantee
# EPISODE_EXPIRY_SECONDS=1800      # 30 min on testnet/local, 1 day on mainnet
# APPROVAL_TTL_SECONDS=3600
# FEE_BUFFER_USDC=0.25           # kept in a payer wallet for Arc fees, which are paid in USDC
